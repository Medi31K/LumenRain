{
  "name": "lumenrain-root",
  "private": true,
  "description": "Convenience wrapper: the app lives in ./app. Run npm commands from here or from ./app.",
  "scripts": {
    "postinstall": "npm --prefix app install",
    "dev": "npm --prefix app run dev",
